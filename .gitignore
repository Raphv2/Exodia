# Fichiers que Git ne doit jamais suivre (ni donc envoyer sur GitHub).
# Dépendances installées par npm (se réinstallent avec npm ci).
node_modules/
# Interface compilée (se refait avec npm run build).
dist/
# Données locales : base SQLite et photos (données personnelles, jamais dans le dépôt).
data/
# Copies locales des données (data-avant-test, data-prod…).
data-*
# Variables secrètes éventuelles (.env, .env.local, .env.prod…), sauf le modèle .env.example
# (le « ! » annule l'exclusion), puis clés et certificats, puis journaux.
.env
.env.*
!.env.example
*.pem
*.key
*.log
# Sauvegardes téléchargées depuis le serveur.
sauvegardes-terrain/
