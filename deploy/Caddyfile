# Terrain : Caddy obtient et renouvelle le certificat HTTPS tout seul.
# install.sh copie ce fichier dans /etc/caddy/Caddyfile en remplaçant le marqueur
# de domaine de la ligne suivante par le vrai domaine.
# Un bloc par site : il suffit d'écrire le nom du site pour que Caddy obtienne le
# certificat HTTPS et redirige automatiquement HTTP vers HTTPS.
__DOMAIN__ {
	# Compresse les réponses (zstd si le navigateur le comprend, sinon gzip).
	encode zstd gzip
	# Taille maximale d'une requête : 20 Mo (l'archive accepte des documents jusqu'à 15 Mo,
	# plus la marge de l'encodage). Au-delà, Caddy répond 413 sans déranger l'app.
	request_body {
		max_size 20MB
	}
	# En-têtes de réponse. L'app envoie déjà les en-têtes de sécurité (CSP, HSTS, nosniff,
	# X-Frame-Options...) : le « ? » ne les pose QUE s'ils manquent (filet de sécurité si une
	# version de l'app les oubliait), donc jamais en double ni avec une autre valeur.
	# HSTS : même valeur que l'app (1 an). Le « - » retire les en-têtes qui annoncent le
	# logiciel utilisé (Server, Via).
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin"
		-Server
		-Via
	}
	# Relaye toutes les requêtes à l'app Node, qui n'écoute que sur la machine (127.0.0.1).
	# Caddy ajoute les en-têtes X-Forwarded-For / -Proto (d'où TRUST_PROXY=1 côté app).
	reverse_proxy 127.0.0.1:3180 {
		# Temps réel (SSE) : on transmet chaque message immédiatement.
		flush_interval -1
	}
}
