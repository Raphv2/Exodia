[Unit]
Description=Terrain (carte militante)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=terrain
Group=terrain
WorkingDirectory=/opt/terrain
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3180
Environment=PUBLIC_URL=https://__DOMAIN__
Environment=TRUST_PROXY=1
Environment=DATA_DIR=/var/lib/terrain
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning --import tsx server/index.ts
Restart=always
RestartSec=3

# Durcissement : l'app ne peut écrire que dans ses données.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/terrain

[Install]
WantedBy=multi-user.target
