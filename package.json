{
  "name": "terrain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Carte militante : panneaux, événements, alertes, agenda et trajets de collage",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/index.ts --dev\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "invite-admin": "tsx server/cli-invite.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "concurrently": "^9.1.0",
    "leaflet": "^1.9.4",
    "lucide": "^0.460.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
