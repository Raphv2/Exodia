# Copie ce fichier en « .env » (à côté de docker-compose.yml) et adapte les valeurs.

# Domaine de l'app (obligatoire) : sert aux liens d'invitation et au certificat HTTPS.
DOMAIN=carte.exemple.fr

# Fuseau horaire du serveur (heure des événements répétés, fin des blocus, sauvegardes).
TZ=Europe/Paris

# Sauvegardes automatiques : heure (0-23) et nombre de jours conservés.
BACKUP_HOUR=4
BACKUP_DAYS=14

# Port de l'app sur la machine (seulement si 3180 est déjà pris).
# TERRAIN_PORT=3180
